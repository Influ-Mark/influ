.card {
  position: absolute;
  left: 130px;
  top: 950px;
  width: 420px;
  height: 370px;
  background-color: #fff6d9;
  border: 1px solid #cccccc;
  border-radius: 3px;
  padding: 40px;
  padding-top: 46px;
  font-family: Arial, sans-serif;
  position: relative;
  overflow: hidden;
}

.top-bar {
  background-color: #e0a915;
  height: 6px;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.logo {
  margin-bottom: 40px;
}

.logo-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  background-color: #e0a915;
  border-radius: 50%;
  margin-right: 8px;
}

.logo-text {
  font-size: 13px;
  color: #292112;
  font-weight: bold;
}

.title {
  font-size: 62px;
  font-weight: 900;
  color: #292112;
  margin-bottom: 20px;
  line-height: 0.95;
  margin-left: -20px;
}

.title-yellow {
  color: #c2930f;
}

.text {
  font-size: 16px;
  color: #292112;
  margin-bottom: 30px;
  width: 300px;
}

.button {
  background-color: #e0a915;
  color: white;
  font-weight: bold;
  font-size: 15px;
  padding: 14px 26px;
  border: none;
  border-radius: 2px;
  cursor: pointer;
}

.button:hover {
  background-color: #c2930f;
}

