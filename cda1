  html, body {
    margin: 0;
    min-height: 100vh;
    width: 100%;
}

body {
    display: flex;
    justify-content: flex-end;
    background:
        radial-gradient(circle at 50% 20%, #fff8dc 0%, transparent 45%),
        linear-gradient(180deg, #f1edaa 0%, #F8D383 50%, #fdea7c 100%),
        url("40f6037cc28f144a534381758c35844b.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

.logo {
    font-size: clamp(36px, 5.5vw, 90px);
    font-family: Arial, sans-serif;
    position: absolute;
    top: clamp(20px, 8vh, 110px);
    left: clamp(24px, 6vw, 100px);
    max-width: 38%;
}

.back {
    background-color: white;
    width: 60%;
    min-width: 700px;
    min-height: 100vh;
    border-bottom-left-radius: 35px;
    padding: 14px 100px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.voltarb {
    width: 220px;
    height: 70px;
    background-color: #F4B938;
    border-radius: 25px;
    border: 0px;
    color: white;
    font-size: 32px;
    cursor: pointer;
    font-family: Arial, sans-serif;
    margin-bottom: 70px;
}

.voltarb:hover { background-color: #B17903; }

.title {
    font-family: Arial, sans-serif;
    font-size: 44px;
    margin: 0 0 16px 0;
}

.text {
    font-family: Arial, sans-serif;
    font-size: 22px;
    margin: 0 0 50px 0;
}

.campo {
    width: 100%;
    max-width: 700px;
    margin-bottom: 26px;
}

.campo input {
    width: 100%;
    max-width: 500px;
    height: 65px;
    padding: 18px;
    border: 2px solid #d9d9d9;
    border-radius: 10px;
    font-size: 20px;
    color: #333333;
    font-family: Arial, sans-serif;
    box-sizing: border-box;
}

.entrarb {
    width: 260px;
    height: 120px;
    background-color: #F4B938;
    border-radius: 25px;
    border: 0px;
    color: white;
    font-size: 38px;
    cursor: pointer;
    font-family: Arial, sans-serif;

    margin: 40px auto 0 auto;
}

.entrarb:hover { background-color: #B17903; }

.text2 {
    font-family: Arial, sans-serif;
    font-size: clamp(22px, 3.2vw, 45px);
    text-align: center;
    position: absolute;
    top: clamp(140px, 25vh, 340px);
    left: clamp(24px, 6vw, 120px);
    max-width: 38%;
    line-height: 1.3;
}


@media (max-width: 900px) {
    body {
        flex-direction: column;
        justify-content: flex-start;
    }

    .logo,
    .text2 {
        position: static;
        max-width: 100%;
        text-align: center;
        padding: 20px 20px 0 20px;
        box-sizing: border-box;
    }

    .back {
        width: 100%;
        min-width: 0;
        min-height: auto;
        padding: clamp(30px, 8vw, 60px) clamp(20px, 6vw, 40px);
        border-radius: 0;
        align-items: center;
    }

    .campo, .campo input {
        max-width: 100%;
    }

    .entrarb {
        margin: 20px auto 0 auto;
    }
}
