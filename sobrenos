* {
    box-sizing: border-box;
}
 
body {
     margin: 0;
    min-height: 100vh;
 
    background:
        radial-gradient(
            circle at 50% 20%,
            #fff8dc 0%,
            transparent 45%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #F8D383 50%,
            #fdea7c 100%
        );
}
 
 .cabecalho {
    background-color: black;
 }

 .title {
    text-align: center;
    font-family: sans-serif;
    font-size: 45px;
    color: white;
    margin: 0;
}
